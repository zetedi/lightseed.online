rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // THE TWO-DOCUMENT BUDGET (ring 2026-09-07). A Storage rules evaluation may touch at most
    // TWO Firestore documents (firestore.get / firestore.exists; repeat calls on one document
    // are cached and free) — a third denies the whole request. The emulator does not enforce
    // it. The old rules spent two on the staff lookup alone (config/superadmin, admins/{uid}),
    // so every non-staff write under communities/ — an owner's logo, a keeper's hero — was
    // refused in production while passing in the emulator. Now each match names the documents
    // it spends, and staff is read first from the ID token (custom claim `admin`, the same
    // claim firestore.rules isStaff honours), which costs none.

    // Staff: the `admin` claim (free), else the node's one superadmin (one document).
    function isStaff() {
      return request.auth != null && (
        request.auth.token.admin == true
        || firestore.get(/databases/(default)/documents/config/superadmin).data.uid == request.auth.uid);
    }

    // Staff may write anywhere.
    match /{allPaths=**} {
      allow write: if isStaff();
    }

    // Everyone may read every picture but the PLANS (ring 2026-10-27): plans/{face}/… holds a
    // house's drawings-in-progress, open to any signed-in being, never to an anonymous fetch.
    // Rules OR together, so the shelf is carved out of the public read by its first segment
    // (a {top} wildcard binds a string; a ** one binds a path, which has no .matches) rather
    // than denied in a match of its own. ** matches zero segments too, so a file at the
    // bucket's root stays open. (No documents spent.)
    match /{top}/{allPaths=**} {
      allow read: if top != 'plans' || request.auth != null;
    }

    // The OLD name, kept: an auth uid is local to this auth provider and dies with it, but
    // everything filed here still resolves, and nothing has to move (the docs store absolute
    // download URLs, not paths). New writes go to beings/{lid} below. (No documents spent.)
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // FILED UNDER THE TRUE NAME (ring 2026-08-09). A lid is portable across nodes and years; a
    // uid is not, and storage is the part most likely to outlive both the auth provider and the
    // database. The credential says uid, so proving the lid costs one Firestore read — the price
    // of a name that survives. A being may write only under its OWN true name. (One document.)
    match /beings/{lid}/{allPaths=**} {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.lid == lid;
    }

    // A community's assets — logo, hero, gallery, events, pages — are written by the hands that
    // KEEP it: the founding anchorUid, or any `keeper` link holder (ring 2026-08-12, the same peers
    // firestore.rules lets edit the community document). ONE document: the community, whose
    // `keeperUids` is the server-kept mirror of its keeper links (functions mintKeeperLinks /
    // resignKeeper; frozen against clients in firestore.rules) — with the staff lookup above,
    // exactly the two the budget allows. Reading the link itself was a third, and denied.
    match /communities/{communityId}/{allPaths=**} {
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/communities/$(communityId)).data.anchorUid == request.auth.uid
        || request.auth.uid in firestore.get(/databases/(default)/documents/communities/$(communityId)).data.get('keeperUids', [])
      );
    }

    // Org-collab logos — adding an org is member-wide (see firestore collabs rules), so any
    // signed-in member may upload a logo for one. (No documents spent.)
    match /collabs/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
