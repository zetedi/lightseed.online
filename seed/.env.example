# Copy to .env and replace this value with a freshly generated password.
# Do not use the example value for a real installation.
SEED_DB_PASSWORD=
SEED_DB_PORT=5433
# The edge (docker compose --profile edge): the application host, the identity host, and how
# certificates are obtained — acme on a VPS (set SEED_ACME_EMAIL), internal for a local walk.
SEED_APP_HOST=app.your-node.example
SEED_IDENTITY_HOST=identity.your-node.example
SEED_TLS=acme
SEED_ACME_EMAIL=
SEED_EDGE_HTTP_PORT=80
SEED_EDGE_HTTPS_PORT=443
# The built application the edge serves (npm run build:independent).
SEED_APP_DIST=../dist-independent
# The node's public origin as the browser reaches it (the application's origin).
SEED_NODE_ORIGIN=https://app.your-node.example
# Face doors of this node (optional, comma-separated hostnames the edge also serves): a community
# keeper's claim on one waits for the steward's grant (staff hand door_grant) instead of a DNS proof.
SEED_FACE_DOORS=
# THE MAIL ORGAN (migration 056): the charter seed:configure wrote (the node's name, domains and
# sender), and the postal line every footer carries (the keeper's address when empty). The SMTP
# courier (SEED_SMTP_URL=smtps://user:pass@host:465) and the push courier's private key
# (SEED_VAPID_PRIVATE_KEY) are secrets: they go in runtime.env beside the database credentials.
SEED_CHARTER_DIR=./charter
SEED_MAIL_POSTAL=
# THE AI ORGAN (migration 057): three secrets, all in runtime.env beside the database credentials —
# the node's own model keys (SEED_ANTHROPIC_API_KEY, SEED_GEMINI_API_KEY; a member benefit, 21 texts
# and 3 pictures a day) and the key under which hands' and places' provider keys rest as ciphertext
# (SEED_CREDENTIAL_KEY=$(openssl rand -base64 32); lose it and every kept key must be entered again).
# Without any of the three the organ is not grown and every model call refuses by name.
# THE CLOCK (migration 058): the node's own rhythm — the morning thirst check (08:00) and the nightly
# stay leaves (03:00) in this IANA zone (the origin's by default), taken from the ledger every tick.
SEED_CLOCK_TIMEZONE=Europe/Brussels
SEED_CLOCK_INTERVAL_MS=60000
