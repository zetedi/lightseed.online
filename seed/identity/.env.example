# Copy to a private .env; do not commit actual credentials.
SEED_IDENTITY_ORIGIN=https://identity.your-node.example
SEED_IDENTITY_REALM_FILE=/absolute/private/path/lightseed-realm.json
SEED_IDENTITY_DB_PASSWORD=
SEED_IDENTITY_ADMIN=
SEED_IDENTITY_ADMIN_PASSWORD=
SEED_IDENTITY_PORT=8082
# The edge network of the node this issuer serves: the same value as SEED_EDGE_NETWORK in seed/.env.
SEED_EDGE_NETWORK=lightseed_edge
